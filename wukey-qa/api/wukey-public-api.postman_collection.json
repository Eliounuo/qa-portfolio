    },
    {
      "name": "A18 Guest delete of a non-existent listing",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([204]);",
              "});"
            ]
          }
        }
      ],
      "request": {
