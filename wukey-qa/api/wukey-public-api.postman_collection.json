      "name": "A17 SQL-injection-like filter value",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400 or 403\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 403]);",
              "});"
            ]
          }
        }
