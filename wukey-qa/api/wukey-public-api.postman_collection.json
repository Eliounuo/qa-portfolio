            "value": "{{anon_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{anon_key}}"
          },
          {
            "key": "Prefer",
            "value": "count=exact"
          }
        ],
        "url": "{{base_url}}/properties?select=id"
      }
    },
    {
      "name": "A20 Pricing items",
